# Local Docker development. Copy to .env only on a NEW installation.
# Never overwrite an existing .env or commit real credentials.
# Production uses .env.production.example and docker-compose.prod.yml instead.

# Django: replace both placeholders before starting a fresh database.
# Preserve SECRET_KEY / FIELD_ENCRYPTION_KEY when restoring encrypted data.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-private-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,host.docker.internal
TZ=America/Guatemala
TIME_ZONE=America/Guatemala
DB_CONN_MAX_AGE=60
# Optional Fernet key; empty derives encryption from SECRET_KEY.
FIELD_ENCRYPTION_KEY=

# Browser URLs. PUBLIC_APP_URL builds verification and invitation links.
# If FRONTEND_PORT changes, update all four URLs below too.
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# PostgreSQL 16. Compose fixes internal host/port to db:5432.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-private-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local Compose Redis has no authentication; production requires a password.
# Host/port and Celery URLs below document the fixed Docker topology.
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Optional native-process overrides; not used by local Compose:
# REDIS_PASSWORD=
# REDIS_CACHE_URL=redis://localhost:6379/2

# Access sessions: 15 minutes; independent of monitoring Free/Pro cadence.
# Compose fixes these values; variables apply to native Django processes.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# SMTP: fill in privately to deliver verification and invitation emails.
# Gmail requires an app password, never your regular account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="Sentinel | GCTechOps <no-reply@example.invalid>"
# Offline tests only: django.core.mail.backends.locmem.EmailBackend does not
# deliver messages or let a human retrieve verification links.
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_DAILY_LIMIT=5

# Turnstile: configure a matched site/secret pair and allowed local hostnames
# in your private .env to test the real integration. Empty is not production-ready.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Beta admission is configured in the database, not opened by this template.
# Empty allowlist adds no domain exception. Registration stays on Free.
BETA_EMAIL_DOMAIN_ALLOWLIST=
BETA_GLOBAL_SCANS_PER_MINUTE=120
BETA_MAX_PENDING_SCANS=60
ENFORCE_LEGACY_EMAIL_VERIFICATION=false

# Configuration previews: independent of the monitoring plan cadence.
DIAGNOSTIC_PER_MINUTE=3
DIAGNOSTIC_FREE_DAILY=20
DIAGNOSTIC_PAID_DAILY=100
DIAGNOSTIC_GLOBAL_PER_MINUTE=60
DIAGNOSTIC_MAX_CONCURRENT=4
DIAGNOSTIC_CACHE_SECONDS=30
# Do not enable without reviewed dry-run and approved backup.
RETENTION_PLAN_CAP_ENFORCED=false

# Direct local access trusts no proxies. Production Compose fixes the Nginx IP.
TRUSTED_PROXY_CIDRS=
TRUST_X_FORWARDED_PROTO=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Observability (optional; no credentials by default).
BLACKBOX_EXPORTER_URL=http://blackbox_exporter:9115
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTINEL_ENV=development
# Optional development-only throttle overrides (not monitoring frequencies):
THROTTLE_USER_RATE=10000/minute
THROTTLE_ANON_RATE=5000/minute

# Agent credentials belong to the separate Sentinine installation.
# Never enable SENTINEL_E2E_FIXTURE in an ordinary development installation.
