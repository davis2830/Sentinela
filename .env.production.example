# Published immutable images
BACKEND_IMAGE=ghcr.io/your-org/sentinel/backend
FRONTEND_IMAGE=ghcr.io/your-org/sentinel/frontend
GATEWAY_IMAGE=ghcr.io/your-org/sentinel/gateway
IMAGE_TAG=sha-0000000
# Leave false. Setting true explicitly authorizes database recreation from the
# verified pre-deploy backup during rollback of an approved irreversible migration.
MIGRATION_IRREVERSIBLE=false

# Public origin and Django
SECRET_KEY=change-me-in-private-env
# Optional Fernet key; preserve it and SECRET_KEY when restoring encrypted data.
FIELD_ENCRYPTION_KEY=
# Set an externally reachable HTTPS control origin; empty disables installation commands.
SENTI9_CONTROL_URL=
SENTI9_IMAGE=davis1924/senti9:1.8.0
SENTI9_DISTRIBUTION_READY=false
ALLOWED_HOSTS=sentinel.gctechops.com,admin.sentinel.gctechops.com
CORS_ALLOWED_ORIGINS=https://sentinel.gctechops.com
CSRF_TRUSTED_ORIGINS=https://sentinel.gctechops.com
SECURE_HSTS_SECONDS=31536000
TZ=America/Guatemala
TIME_ZONE=America/Guatemala
DB_CONN_MAX_AGE=60

# PostgreSQL 16
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-private-env

# Redis
REDIS_PASSWORD=change-me-in-private-env

# TLS files already provisioned on the Docker host
TLS_CERT_PATH=/etc/sentinel/tls/fullchain.pem
TLS_KEY_PATH=/etc/sentinel/tls/privkey.pem
# Gateway runs as nginx (UID/GID 101 in this image). Provision the real key
# readable by that group (e.g. root:101, mode 0440); do not make it world-readable.

# Used by the deployment workflow for the public HTTPS probe
PUBLIC_HEALTHCHECK_URL=https://sentinel.example.com/health/

# Beta is closed by default in the database; open only after the delivery gates.
PUBLIC_APP_URL=https://sentinel.gctechops.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=change-me-in-private-env
TURNSTILE_HOSTNAMES=sentinel.gctechops.com
EMAIL_HOST=smtp.gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_PORT=587
EMAIL_HOST_USER=change-me-in-private-env
EMAIL_HOST_PASSWORD=change-me-in-private-env
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="Sentinel | GCTechOps <no-reply@example.invalid>"
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_DAILY_LIMIT=5
BETA_EMAIL_DOMAIN_ALLOWLIST=
BETA_GLOBAL_SCANS_PER_MINUTE=120
BETA_MAX_PENDING_SCANS=60
# Do not enable before reviewing and verifying the existing cohort.
ENFORCE_LEGACY_EMAIL_VERIFICATION=false
# Historical retention ceiling requires reviewed dry-run and approved backup.
RETENTION_PLAN_CAP_ENFORCED=false

# Configuration previews have a separate budget from persisted monitoring.
DIAGNOSTIC_PER_MINUTE=3
DIAGNOSTIC_FREE_DAILY=20
DIAGNOSTIC_PAID_DAILY=100
DIAGNOSTIC_GLOBAL_PER_MINUTE=60
DIAGNOSTIC_MAX_CONCURRENT=4
DIAGNOSTIC_CACHE_SECONDS=30

# Optional observability.
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTINEL_ENV=production
# Production Compose fixes JWT access/refresh to 15 minutes / 7 days,
# the trusted proxy to 172.30.0.10/32, and internal database/broker URLs.
